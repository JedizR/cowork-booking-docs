# Copy to .env to override. Every value here is a local dev value, also the compose default.
# Never put real secrets in this file. Lengths: SECRET_KEY and API tokens >= 32, OPERATOR_PASSWORD and STAFF_PASSWORD >= 12 (ADR-0019). TEST_CLOCK_ENABLED is not here: only compose.e2e.yaml sets it.

# One password per database (POSTGRES_PASSWORD and the password inside that service's DATABASE_URL)
PURCHASE_DB_PASSWORD=dev-purchase-db
PAYMENT_DB_PASSWORD=dev-payment-db
ACCESS_DB_PASSWORD=dev-access-db

# SECRET_KEY of each service; a different key per service
PURCHASE_SECRET_KEY=dev-purchase-secret-key-0123456789abcdef
PAYMENT_SECRET_KEY=dev-payment-secret-key-0123456789abcdef
ACCESS_SECRET_KEY=dev-access-secret-key-0123456789abcdef

# Bearer tokens: the same value in Purchase and in the provider
PAYMENT_API_TOKEN=dev-payment-api-token-0123456789abcdef
ACCESS_API_TOKEN=dev-access-api-token-0123456789abcdef

# Operator and kiosk sign-in
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=dev-operator-password
STAFF_PASSWORD=dev-staff-password

# Shown by GET /health on all three
APP_REVISION=dev

# No container reads this: the e2e suite's Purchase password for OPERATOR_EMAIL
E2E_OPERATOR_PASSWORD=dev-operator-login
