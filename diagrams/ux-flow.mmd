flowchart LR
  Member([Member])
  Operator([Operator])
  Staff([Staff])
  subgraph Purchase
    REG["Register /register<br/>email taken: says so (PUR-R01)"]
    LOGIN["Log in /login<br/>one uniform error (PUR-R02)"]
    SPACES["Spaces /<br/>name, capacity, THB per hour and per 30 min"]
    GRID["Space /spaces/id?date&blocks<br/>date input, 1-8 blocks, start grid<br/>disabled starts: Too soon, Runs past 20:00, Booked"]
    FORM["Book form on the space page<br/>party size, note, price THB 450.00<br/>Continue to payment"]
    BOOKING["Booking /bookings/ref<br/>held: Pay by 10:13 countdown<br/>confirmed: View e-ticket or being prepared<br/>cancelled, expired, completed"]
    CANCEL["Cancel /bookings/ref/cancel<br/>shows the refund before confirming"]
    MINE["My bookings /bookings/mine<br/>upcoming and past"]
    OPB["Operator bookings /operator/bookings<br/>Cancel, Retry, Reconcile"]
    OPS["Operator spaces /operator/spaces<br/>create, edit, archive"]
    OPM["Operator members /operator/members<br/>plan toggle"]
    DASH["Dashboard /dashboard<br/>last 7 Bangkok days (PUR-R34)"]
  end
  subgraph Payment
    PAYPAGE["Hosted checkout /pay/ps_...<br/>THB 450.00, BK-7KQ2M9, test-mode banner<br/>card number, MM/YY, CVC, Pay, Back"]
    DECLINE["Declined: reason inline<br/>session stays open (PMT-R10)"]
    EXPIRED["Expired: This payment session has expired.<br/>GET 200, Pay 409, no attempt taken (PMT-R11)"]
    PAYOP["Payment operator /operator<br/>totals, needs manual follow-up"]
  end
  subgraph Access
    TICKET["E-ticket /t/ticket_token<br/>code H7K3-9QXA and QR<br/>Issued, Checked in, Expired, Cancelled overlay"]
    KIOSK["Kiosk /checkin<br/>select room, scan or type code"]
    RESULT["Result in large type<br/>ok, not_open_yet, closed,<br/>revoked, wrong_room, unknown_code"]
  end
  Member --> REG --> LOGIN --> SPACES --> GRID --> FORM
  FORM -->|"pay coverage: 303"| PAYPAGE
  FORM -->|"plan or free: confirmed at once"| BOOKING
  FORM -->|"flash: Slot just taken"| GRID
  PAYPAGE -->|"decline"| DECLINE
  DECLINE -->|"try again"| PAYPAGE
  PAYPAGE -->|"at or after expires_at"| EXPIRED
  PAYPAGE -->|"paid: success_url, then 303"| BOOKING
  PAYPAGE -->|"Back: cancel_url"| BOOKING
  LOGIN --> MINE --> BOOKING
  BOOKING -->|"View e-ticket"| TICKET
  BOOKING -->|"Cancel"| CANCEL
  CANCEL -->|"POST, flash"| BOOKING
  Operator --> OPB
  Operator --> OPS
  Operator --> OPM
  Operator --> DASH
  Operator --> PAYOP
  OPB -->|"open"| BOOKING
  Staff --> KIOSK --> RESULT
  RESULT -->|"next scan"| KIOSK
  classDef actor fill:#ffffff,stroke:#334155,color:#0f172a
  classDef purchase fill:#dbeafe,stroke:#1d4ed8,color:#0b1b3f
  classDef payment fill:#dcfce7,stroke:#15803d,color:#052e16
  classDef access fill:#fef3c7,stroke:#b45309,color:#3b1d02
  class Member,Operator,Staff actor
  class REG,LOGIN,SPACES,GRID,FORM,BOOKING,CANCEL,MINE,OPB,OPS,OPM,DASH purchase
  class PAYPAGE,DECLINE,EXPIRED,PAYOP payment
  class TICKET,KIOSK,RESULT access
  style Purchase fill:#dbeafe,stroke:#1d4ed8
  style Payment fill:#dcfce7,stroke:#15803d
  style Access fill:#fef3c7,stroke:#b45309
